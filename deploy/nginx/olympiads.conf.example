upstream olympiads_api {
    server 127.0.0.1:5050;
    keepalive 16;
}

upstream olympiads_frontend {
    server 127.0.0.1:5188;
    keepalive 8;
}

server {
    listen 80;
    server_name olympiads.example.ru;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name olympiads.example.ru;

    # Configure certificates here or let certbot manage these directives.
    ssl_certificate /etc/letsencrypt/live/olympiads.example.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/olympiads.example.ru/privkey.pem;

    client_max_body_size 2m;

    location /api/ {
        proxy_pass http://olympiads_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /auth/crm/ {
        proxy_pass http://olympiads_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://olympiads_frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

