COMPOSE_PROJECT_NAME=olympiads
IMAGE_TAG=latest

# Внешний nginx обращается только к этим loopback-портам.
API_PORT=5050
FRONTEND_PORT=5188

# Сгенерируйте оба значения через `openssl rand -hex 32`.
# Hex-пароль безопасно подставляется в DATABASE_URL без URL-escaping.
SECRET_KEY=replace-with-at-least-32-random-characters
POSTGRES_DB=olympiads
POSTGRES_USER=olympiads
POSTGRES_PASSWORD=replace-with-a-random-hex-password

ACADEMIC_YEAR=2026/27
APP_BASE_URL=https://olympiads.example.ru
FRONTEND_BASE_URL=https://olympiads.example.ru
CORS_ORIGINS=https://olympiads.example.ru
SESSION_COOKIE_SECURE=true

# Redis URL задаются непосредственно в compose.yaml:
# /0 — Celery broker, /1 — Celery results, /2 — пользовательские сессии.

CRM_OIDC_ISSUER=https://lk.silaeder.ru
CRM_OIDC_CLIENT_ID=olympiads
CRM_OIDC_CLIENT_SECRET=replace-with-crm-client-secret
CRM_OIDC_SCOPES=openid profile email roles

CRM_NOTIFICATION_URL=https://lk.silaeder.ru/api/external/notifications
CRM_NOTIFICATION_TIMEOUT_SECONDS=10
CRM_NOTIFICATION_RETRY_BASE_SECONDS=30
CRM_NOTIFICATION_RETRY_MAX_SECONDS=3600
CRM_NOTIFICATION_PROCESSING_LEASE_SECONDS=900
CRM_NOTIFICATION_MAX_ATTEMPTS=12
CRM_NOTIFICATION_MAX_AGE_DAYS=1
CRM_NOTIFICATION_SCAN_BATCH=500

GUNICORN_WORKERS=2
GUNICORN_THREADS=4
